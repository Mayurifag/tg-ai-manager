{% extends "base.html.j2" %}

{% block body_class %}chat-page{% endblock %}

{% block title %}
{% if chat %}
{{ chat.name }}
{% else %}
Messages
{% endif %}
{% endblock %}

{% block head_extra %}
<link rel="stylesheet" href="/static/css/chat_styles.css?t={{ 'static/css/chat_styles.css' | file_mtime }}">
<link rel="stylesheet" href="/static/css/post.css?t={{ 'static/css/post.css' | file_mtime }}">
{% endblock %}

{% block sidebar_back %}
{% if topic_id %}
<a href="/forum/{{ chat_id }}" class="back-link">← Back to Topics</a>
{% else %}
<a href="/" class="back-link">← Back to Chats</a>
{% endif %}
{% endblock %}

{% block sidebar_info %}
{% if chat %}
<div class="chat-profile">
    {% if chat.image_url %}
    <img src="{{ chat.image_url }}" alt="" class="chat-profile-avatar">
    {% else %}
    <div class="chat-profile-avatar chat-profile-placeholder">
        {{ chat.name[0] | upper }}
    </div>
    {% endif %}
    <h3>{{ chat.name }}</h3>
    <p>{{ chat.type.value | title }}</p>
</div>

<details class="chat-actions-container" id="chat-controls" open>
    <summary class="actions-header">Chat controls</summary>
    <div class="actions-grid">
        <button type="button" class="action-item" id="btn-toggle-autoread" title="{{ 'Inherited from forum; disable the forum rule first' if autoread_inherited else 'Toggle Autoread' }}" aria-pressed="{{ 'true' if autoread_enabled else 'false' }}">
            <span class="icon">👀</span>
            <span class="label">Autoread{% if autoread_inherited %} (forum){% endif %}</span>
            <span class="status-indicator {{ 'on' if autoread_enabled else 'off' }}" aria-hidden="true"></span>
        </button>

        <button type="button" class="action-item" id="btn-open-autoreact" title="Configure Autoreact" aria-haspopup="dialog">
            <span class="icon">⚡</span>
            <span class="label">Autoreact</span>
            <span class="status-indicator status-{{ autoreact_status }}" id="autoreact-indicator" aria-hidden="true"></span>
        </button>

        <button type="button" class="action-item" id="btn-toggle-ai-autoread" title="{{ 'Inherited from forum; disable the forum rule first' if ai_autoread_inherited else 'Toggle AI Autoread' }}" aria-pressed="{{ 'true' if ai_autoread_enabled else 'false' }}">
            <span class="icon">🤖</span>
            <span class="label">AI Read{% if ai_autoread_inherited %} (forum){% endif %}</span>
            <span class="status-indicator {{ 'on' if ai_autoread_enabled else 'off' }}" aria-hidden="true"></span>
        </button>

        <button type="button" class="action-item" id="btn-read-chat" title="Mark All Read">
            <span class="icon">✅</span>
            <span class="label">Mark Read</span>
        </button>

        {% if topic_id %}
        <button type="button" class="action-item" id="btn-apply-topics" title="Copy Autoread to All Topics">
            <span class="icon">📋</span>
            <span class="label">Copy All</span>
        </button>
        {% endif %}
    </div>
</details>
{% endif %}
{% endblock %}

{% block settings %}
{% endblock %}

{% block content %}
<div id="loading-indicator" class="history-status" role="status" aria-live="polite" hidden>Loading older messages…</div>
<div id="reading-position-status" class="history-status" role="status" aria-live="polite" hidden></div>
<div class="messages-container" id="messages-container">
    {% include "chat/messages_partial.html.j2" %}
    {% if not messages %}<p class="empty-messages">No messages to show.</p>{% endif %}
</div>
<button type="button" id="load-newer-messages" class="history-more" hidden>Load newer messages</button>
<button type="button" id="jump-to-latest" class="jump-to-latest" hidden></button>
<button type="button" id="return-to-reading" class="jump-to-latest return-to-reading" hidden>Return to previous position</button>

<div id="toast"></div>

<dialog id="autoreact-modal" class="modal-overlay" aria-labelledby="autoreact-title">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="autoreact-title">Autoreact Configuration</h3>
            <button type="button" class="modal-close" onclick="closeArModal()" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <label class="toggle-switch-wrapper">
                <input type="checkbox" id="autoreact-checkbox">
                <span class="toggle-slider"></span>
                <span class="toggle-label">Enable Autoreact</span>
            </label>

            <div class="section-label">Reaction Emoji</div>
            <div class="emoji-selector" id="emoji-selector">
                <button type="button" class="emoji-opt selected" data-emoji="💩" aria-label="React with 💩" aria-pressed="true">💩</button>
                <button type="button" class="emoji-opt" data-emoji="🤡" aria-label="React with 🤡" aria-pressed="false">🤡</button>
                <button type="button" class="emoji-opt" data-emoji="❤️" aria-label="React with ❤️" aria-pressed="false">❤️</button>
                <input type="text" id="custom-emoji-input" aria-label="Custom reaction" placeholder="Custom" maxlength="4">
            </div>

            <div id="ar-user-section" style="display: {{ 'none' if chat.type.value == 'channel' else 'block' }};">
                <div class="section-label">Target Users (Optional)</div>
                <div class="user-selector-wrapper">
                    <div class="user-selector-display" id="user-display">
                        <span style="color: #666; font-style: italic;">Loading...</span>
                    </div>
                    <button type="button" class="user-selector-toggle" id="user-dropdown-toggle" aria-expanded="false" aria-controls="user-dropdown" onclick="toggleUserDropdown()">Choose users</button>
                    <div class="user-dropdown" id="user-dropdown" hidden>
                        <div style="padding: 10px; color: #aaa; font-style: italic;">Loading users...</div>
                    </div>
                </div>

                <div id="ar-warning-box"
                    style="margin-top: 15px; background: rgba(244, 67, 54, 0.1); border: 1px solid #f44336; border-radius: 4px; padding: 10px; display: none;">
                    <strong style="color: #f44336;">⚠️ High Risk of Flood Wait</strong>
                    <p style="margin: 5px 0 0 0; color: #ddd; font-size: 0.85rem;">
                        Autoreacting to <strong>ALL messages</strong> may cause Telegram to temporarily ban this account
                        from interactions. Use with caution.
                    </p>
                </div>

                <div class="help-text" id="ar-help-text">Leave empty to react to ALL incoming messages.</div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" onclick="closeArModal()">Cancel</button>
            <button class="btn-save" id="save-ar-btn">Save Configuration</button>
        </div>
    </div>
</dialog>

{% endblock %}

{% block scripts %}
<script>
    window.TG_CHAT = {
        chatId: {{ chat_id }},
        topicId: {{ topic_id if topic_id is not none else 'null' }},
        accountId: {{ account_id | tojson }},
        isPremium: {{ 'true' if is_premium else 'false' }},
        isChannel: {{ 'true' if chat.type.value == 'channel' else 'false' }}
    };
</script>
<script src="/static/js/chat.js?t={{ 'static/js/chat.js' | file_mtime }}"></script>
{% endblock %}
