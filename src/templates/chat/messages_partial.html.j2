{% macro render_reactions(msg, album_index=none) %}
<div class="reactions-container" id="reactions-{{ msg.id }}"{% if album_index %} data-album-index="{{ album_index }}"{% endif %}>{% for r in msg.reactions %}
    <button type="button" class="reaction-pill {{ 'chosen' if r.is_chosen else '' }}"
        data-msg-id="{{ msg.id }}" data-emoji="{{ r.custom_emoji_id if r.custom_emoji_id else r.emoji }}"
        aria-pressed="{{ 'true' if r.is_chosen else 'false' }}" aria-label="React {% if album_index %}to album item {{ album_index }} {% endif %}with {{ r.emoji }}">
        {% if r.custom_emoji_id %}<img src="/media/custom_emoji/{{ r.custom_emoji_id }}" alt="" loading="lazy">
        {% else %}<span>{{ r.emoji }}</span>{% endif %}
        <span class="reaction-count">{{ r.count }}</span>
    </button>
{% endfor %}</div>
{% endmacro %}

{% macro render_visual(msg) %}
{% set frame_width, media_width, media_height = msg.media_geometry %}
<div class="media-preview-frame" style="--media-width: {{ frame_width }}px; --media-ratio: {{ media_width }} / {{ media_height }}">
    {% if msg.is_video %}
    <video controls preload="none" class="message-video"><source src="/media/{{ chat_id }}/{{ msg.id }}"></video>
    {% else %}
    <button type="button" class="media-image-button" aria-label="Open photo" onclick="openLightbox(this.firstElementChild)">
        <img src="/media/{{ chat_id }}/{{ msg.id }}" class="inline-media lightbox-trigger" data-full-src="/media/{{ chat_id }}/{{ msg.id }}/full" loading="lazy" alt="Photo">
    </button>
    {% endif %}
</div>
{% endmacro %}

{% for msg in messages %}
{% if msg.is_service %}
<div class="service-message-row" id="msg-{{ msg.id }}" data-id="{{ msg.id }}" data-oldest-id="{{ msg.id }}">
    <div class="service-message-bubble">{{ msg.sender_name }} {{ msg.text | safe }}</div>
</div>
{% else %}
<article class="message-row {{ 'outgoing' if msg.is_outgoing else 'incoming' }}" id="msg-{{ msg.id }}"
    data-id="{{ msg.id }}" data-oldest-id="{{ msg.album_parts[0].id if msg.album_parts else msg.id }}"{% if msg.grouped_id %} data-grouped-id="{{ msg.grouped_id }}"{% endif %}>
    {% if not msg.is_outgoing %}
    <div class="message-avatar">
        {% if msg.avatar_url %}
        <img src="{{ msg.avatar_url }}" alt="" loading="lazy">
        {% else %}
        <div class="avatar-placeholder" style="background-color: {{ msg.sender_color or 'var(--surface-border)' }}">{{ msg.sender_initials or '?' }}</div>
        {% endif %}
    </div>
    {% endif %}
    <div class="message-bubble">
        {% if not msg.is_outgoing and msg.sender_name %}<span class="sender">{{ msg.sender_name }}</span>{% endif %}
        {% if msg.forwarded_from %}<div class="forwarded-from">Forwarded from {{ msg.forwarded_from }}</div>{% endif %}

        {% if msg.reply_to_msg_id %}
        <a href="#msg-{{ msg.reply_to_msg_id }}" class="reply-indicator">
            <span class="reply-name">{{ msg.reply_to_sender_name or 'Reply' }}</span>
            <span class="reply-text">{{ msg.reply_to_text or 'Message unavailable' }}</span>
        </a>
        {% endif %}

        {% if msg.album_parts %}
        {% set count = msg.album_parts | length %}
        <div class="media-content album-grid {{ 'items-' ~ count if count <= 4 else 'items-more' }}">
            {% for part in msg.album_parts %}
            <div class="album-item"{% if part.id != msg.id %} id="msg-{{ part.id }}"{% endif %} data-message-id="{{ part.id }}">
                {% if part.is_video or part.is_photo %}
                {{ render_visual(part) }}
                {% elif part.is_audio %}
                <div class="audio-player">
                    <div class="attachment-title">{{ '🎤 Voice message' if part.is_voice else (part.audio_title or 'Audio') }}</div>
                    {% if part.audio_performer %}<div class="attachment-detail">{{ part.audio_performer }}</div>{% endif %}
                    <audio controls preload="none" src="/media/{{ chat_id }}/{{ part.id }}"></audio>
                </div>
                {% else %}
                <a class="file-attachment" href="/media/{{ chat_id }}/{{ part.id }}/full">{{ part.file_name or 'Open attachment' }}</a>
                {% endif %}
                {{ render_reactions(part, loop.index) }}
            </div>
            {% endfor %}
        </div>
        {% elif msg.is_video %}
        <div class="media-content">{{ render_visual(msg) }}</div>
        {% elif msg.is_sticker %}
        <div class="media-content"><img class="message-sticker" src="/media/{{ chat_id }}/{{ msg.id }}" loading="lazy" alt="{{ msg.sticker_emoji or 'Sticker' }}"></div>
        {% elif msg.is_photo %}
        <div class="media-content">{{ render_visual(msg) }}</div>
        {% elif msg.is_audio %}
        <div class="audio-player">
            <div class="attachment-title">{{ '🎤 Voice message' if msg.is_voice else (msg.audio_title or 'Audio') }}</div>
            {% if msg.audio_performer %}<div class="attachment-detail">{{ msg.audio_performer }}</div>{% endif %}
            <audio controls preload="none" src="/media/{{ chat_id }}/{{ msg.id }}"></audio>
        </div>
        {% elif msg.is_poll %}
        <div class="poll-content">
            <div class="attachment-detail">Poll · View only</div>
            <div class="attachment-title">{{ msg.poll_question or 'Poll' }}</div>
            {% for option in msg.poll_options %}<div class="poll-option">{{ option }}</div>{% endfor %}
        </div>
        {% elif msg.is_document %}
        <a class="file-attachment" href="/media/{{ chat_id }}/{{ msg.id }}/full">
            <span aria-hidden="true">📄</span><span><strong>{{ msg.file_name or 'File' }}</strong>{% if msg.file_size is not none %}<small>{{ msg.file_size | filesizeformat }}</small>{% endif %}</span>
        </a>
        {% elif msg.has_media and not msg.webpage_url %}
        <div class="attachment-detail">Unsupported attachment</div>
        {% endif %}

        {% if msg.text %}<div class="text">{{ msg.text | safe }}</div>{% endif %}
        {% if msg.webpage_url %}
        <a class="webpage-preview" href="{{ msg.webpage_url }}" target="_blank" rel="noopener noreferrer">
            <strong>{{ msg.webpage_title or msg.webpage_url }}</strong>
            {% if msg.webpage_description %}<span>{{ msg.webpage_description }}</span>{% endif %}
        </a>
        {% endif %}

        {% if not msg.album_parts %}{{ render_reactions(msg) }}{% endif %}
        <button type="button" class="hover-reaction" data-msg-id="{{ msg.id }}" data-emoji="💩" aria-label="React with 💩" title="React with 💩">💩</button>
        {% if current_user and current_user.debug_mode %}<button type="button" class="debug-process" onclick="debugProcessMessage(this, {{ msg.id }})" aria-label="Dry run rules" title="Dry run rules">⚙️</button>{% endif %}
        <time class="time local-time" datetime="{{ msg.date.isoformat() }}" data-timestamp="{{ msg.date.isoformat() }}"></time>
    </div>
</article>
{% endif %}
{% endfor %}
