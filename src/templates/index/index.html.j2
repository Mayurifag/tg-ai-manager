{% extends "base.html.j2" %}
{% block head_extra %}
<link rel="stylesheet" href="/static/css/chat_list.css?t={{ 'static/css/chat_list.css' | file_mtime }}">
<link rel="stylesheet" href="/static/css/index_styles.css?t={{ 'static/css/index_styles.css' | file_mtime }}">
{% endblock %}

{% block sidebar_back %}
{% endblock %}

{% block settings %}
{% endblock %}

{% block content %}
<div class="chat-list" id="chat-list-container">
    {% with chats = page.chats %}{% include "partials/chat_cards.html.j2" %}{% endwith %}
</div>
<button id="load-more-chats" class="load-more-chats" type="button"
    data-snapshot="{{ page.snapshot }}" data-next-offset="{{ page.next_offset if page.next_offset is not none else '' }}"
    {% if page.next_offset is none %}hidden{% endif %}>Load more chats</button>
<div id="chat-list-status" class="chat-list-status" role="status" aria-live="polite"></div>

{% endblock %}

{% block scripts %}
<script src="/static/js/index.js?t={{ 'static/js/index.js' | file_mtime }}"></script>
{% endblock %}
