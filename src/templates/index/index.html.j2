{% extends "base.html.j2" %}
{% block head_extra %}
<link rel="stylesheet" href="/static/css/chat_list.css?t={{ 'static/css/chat_list.css' | file_mtime }}">
<link rel="stylesheet" href="/static/css/index_styles.css?t={{ 'static/css/index_styles.css' | file_mtime }}">
{% endblock %}

{% block sidebar_back %}
{% endblock %}

{% block settings %}
{% endblock %}

{% block content %}
<header class="page-heading">
    <div><h1>Chats</h1><p>Unread first · Your Telegram conversations</p></div>
    <button id="refresh-chats" class="secondary-button" type="button">Refresh</button>
</header>
<div class="chat-list" id="chat-list-container" aria-busy="true">
    {% for _ in range(6) %}<div class="chat-skeleton" aria-hidden="true"><span></span><div></div></div>{% endfor %}
</div>
<button id="load-more-chats" class="load-more-chats" type="button"
    data-snapshot="" data-next-offset="0">Load more chats</button>
<div id="chat-list-status" class="chat-list-status" role="status" aria-live="polite">Loading chats…</div>
<noscript>Enable JavaScript to load your Telegram chats.</noscript>

{% endblock %}

{% block scripts %}
<script src="/static/js/index.js?t={{ 'static/js/index.js' | file_mtime }}"></script>
{% endblock %}
