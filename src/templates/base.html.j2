<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-scheme" content="dark">
    <title>{% block title %}Telegram Manager{% endblock %}</title>
    <script>
        try {
            if (localStorage.getItem("tg-sidebar-collapsed") === "true")
                document.documentElement.classList.add("sidebar-collapsed");
        } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?t={{ 'static/favicon.svg' | file_mtime }}">
    <link rel="stylesheet" href="/static/css/base.css?t={{ 'static/css/base.css' | file_mtime }}">
    <script id="twemoji-script" async src="https://cdn.jsdelivr.net/npm/@twemoji/api@17.0.3/dist/twemoji.min.js"
        integrity="sha384-Y5xukbGJwykbHHkTbLJykYLcBPFxrwipTbEh0puxhkz9CZ90raTPGe2Ks4vCxsYU"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    {% block head_extra %}{% endblock %}
</head>

<body{% if current_user and current_user.debug_mode %} class="debug-layout"{% endif %}>
    <div class="app-container">
        <!-- LEFT SIDEBAR -->
        <aside class="sidebar left-sidebar" id="left-sidebar">
            <div class="sidebar-top">
                <button type="button" id="sidebar-toggle" aria-controls="left-sidebar" aria-expanded="true"
                    aria-label="Collapse navigation" title="Collapse navigation" hidden>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>
                    </svg>
                </button>
                {% block sidebar_back %}{% endblock %}
            </div>

            <div class="sidebar-content">
                {% block sidebar_info %}
                {% endblock %}
            </div>

            <!-- Navigation Links -->
            <div class="sidebar-nav">
                <a href="/stickers" class="setting-option sidebar-link" aria-label="Stickers" title="Stickers"{% if request.path == '/stickers' %} aria-current="page"{% endif %}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 3h12a3 3 0 0 1 3 3v8l-7 7H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM14 21v-4a3 3 0 0 1 3-3h4M8 8h.01M15 8h.01M8 12c1 1.5 3 2 4.5 1"/>
                    </svg>
                    <span class="sidebar-label">Stickers</span>
                </a>
                <a href="/settings" class="setting-option sidebar-link" aria-label="Settings" title="Settings">
                    <span aria-hidden="true">⚙️</span><span class="sidebar-label">Settings</span>
                </a>
                <a href="/actions" class="setting-option sidebar-link" aria-label="Actions Log" title="Actions Log">
                    <span aria-hidden="true">📜</span><span class="sidebar-label">Actions Log</span>
                </a>
                <div class="sidebar-context">{% block settings %}{% endblock %}</div>
            </div>

            <!-- User Profile Section (Pinned Bottom) -->
            {% set sidebar_name = profile_name or (current_user.username if current_user else '') %}
            {% if sidebar_name %}
            <div class="user-profile-section">
                <div class="sidebar-avatar" aria-hidden="true">
                    <span>{{ sidebar_name.lstrip('@')[:1] | upper or '?' }}</span>
                    {% if profile_avatar_id %}<img src="{{ url_for('media.get_avatar', chat_id=profile_avatar_id) }}" alt="">{% endif %}
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-username" title="{{ sidebar_name }}">{{ sidebar_name }}</div>
                    {% if current_user and current_user.username and current_user.username.startswith('@') and current_user.username != sidebar_name %}
                    <div class="sidebar-handle" title="{{ current_user.username }}">{{ current_user.username }}</div>
                    {% endif %}
                    {% if current_user %}<div class="sidebar-status">{{ 'Premium' if current_user.is_premium else 'Standard' }}</div>{% endif %}
                </div>
            </div>
            {% endif %}
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            {% block content %}{% endblock %}
        </main>

        <!-- RIGHT SIDEBAR (Live Events) - HIDDEN UNLESS DEBUG MODE -->
        {% if current_user and current_user.debug_mode %}
        <aside class="sidebar right-sidebar">
            <div class="sidebar-feed">
                <div class="settings-header" style="color: #6ab7ff;">Live Events (Debug)</div>
                <p>Stored event history normally lasts about three hours, up to 10,000 events.</p>
                <div id="event-feed-list">
                    {% set recent_events = load_debug_events() %}
                    {% if recent_events is none %}
                    <div class="event-history-warning" role="status">Event history is unavailable. Live events may still appear.</div>
                    {% elif recent_events %}
                    {% for event in recent_events %}
                    {% if event.type not in ['read', 'edited', 'raw'] %}
                    <div class="event-item type-{{ event.type }}">
                        <div class="event-header">
                            {% if event.type == 'deleted' %}
                            <span class="event-type-icon" title="Deleted">🗑️</span>
                            {% elif event.type == 'action' %}
                            <span class="event-type-icon" title="Action">⚡</span>
                            {% elif event.type == 'reaction_update' %}
                            <span class="event-type-icon" title="Reaction">👍</span>
                            {% endif %}

                            <a href="{{ event.link or '#' }}" class="event-chat-link" {% if event.topic_name
                                %}title="{{ event.topic_name }}" {% endif %}>
                                {{ event.topic_name ~ ' - ' if event.topic_name else '' }}{{ event.chat_name }}
                            </a>
                        </div>

                        <!--
                          Event Text Wrapper
                          DEBUG MODE: shows raw JSON in tooltip via data-full-html
                        -->
                        <div class="event-text-wrapper" data-full-html="{{ event | to_json | escape }}">
                            <div class="event-text">
                                {{ event.text | plain_text }}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                    {% else %}
                    <div class="empty-feed">No recent events</div>
                    {% endif %}
                </div>
            </div>
        </aside>
        {% endif %}
    </div>

    <!-- Global Tooltip -->
    <div id="global-tooltip"></div>

    <!-- Lightbox Modal -->
    <dialog id="lightbox" aria-label="Photo viewer" onclick="closeLightbox()">
        <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Close photo">&times;</button>
        <button type="button" class="lightbox-nav nav-prev" onclick="event.stopPropagation(); navigateLightbox(-1)" aria-label="Previous photo">&#10094;</button>
        <button type="button" class="lightbox-nav nav-next" onclick="event.stopPropagation(); navigateLightbox(1)" aria-label="Next photo">&#10095;</button>
        <div id="lightbox-loading">Loading full size...</div>
        <img id="lightbox-img" alt="Full View" onclick="event.stopPropagation()">
    </dialog>

    <script>
        window.TG_CONFIG = {
            debug: {{ 'true' if current_user and current_user.debug_mode else 'false' }},
            account: {{ account_token | tojson }}
        };
    </script>
    <script src="/static/js/base.js?t={{ 'static/js/base.js' | file_mtime }}"></script>
    {% block scripts %}{% endblock %}
</body>

</html>
