{% import "macros/chat_card.html.j2" as cards %}
<div class="chat-card-wrapper" data-chat-id="{{ chat.id }}" data-is-unread="{{ 'true' if chat.unread_count > 0 else 'false' }}"
    data-message-id="{{ chat.last_message_id or '' }}" data-message-date="{{ chat.last_message_date.isoformat() if chat.last_message_date else '' }}"
    {% if chat.is_pinned %}data-is-pinned="true"{% endif %}>
    {{ cards.render_chat_card(chat) }}
</div>